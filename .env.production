# Committed, PUBLIC build-time config for production builds (next build sets
# NODE_ENV=production and loads this file). Only NEXT_PUBLIC_* values, which are
# inlined into the client bundle and are public by nature — never put secrets
# here (those are Worker secrets via `wrangler secret put`).
#
# Why this file exists: the Cloudflare Git-connected build has no .env.local, so
# without this NEXT_PUBLIC_CAL_USERNAME and NEXT_PUBLIC_SITE_URL would be empty
# and booking/canonical/magic-links would break. It also pins the emulator flag
# OFF so a CI build can never ship an emulator-pointed bundle.
#
# Note: a LOCAL build still has .env.local, and shell-exported vars, which both
# take precedence over this file — so local `npm run deploy` still needs the
# emulator-off override. This file only governs environments without .env.local
# (i.e. the Cloudflare CI build).

NEXT_PUBLIC_SITE_URL=https://physioonclick.co.uk
NEXT_PUBLIC_CAL_USERNAME=physioonclick
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB2W4dHgl3mM8QEY5XYiQcSt9usFV35jSw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=physioonclick.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=physioonclick
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=physioonclick.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=119591358761
NEXT_PUBLIC_FIREBASE_APP_ID=1:119591358761:web:78643d985cc47c56baa738

# Set this to the G-XXXXXXX Measurement ID (Firebase console → Project settings
# → your Web app) to switch Firebase Analytics on. Empty = analytics dormant.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
