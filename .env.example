NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CAL_USERNAME=krunal-nayak-0nbytj
NEXT_PUBLIC_GA_ID=
# Firebase Analytics measurement id (G-XXXXXXX) from Firebase console → Project
# settings → your Web app. Inlined at BUILD time, so set it as a Cloudflare
# build variable in production, not a Worker runtime var. Empty = analytics off.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# --- Payments (Stripe) ---
# Server-only. On Cloudflare, set with: wrangler secret put STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET comes from the Stripe webhook endpoint (dashboard) or
# `stripe listen` for local dev. Both are test keys (sk_test_/whsec_) until go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Insurance receipt emails reuse the existing RESEND_API_KEY + ENQUIRY_EMAIL_FROM
# below (no new secrets). Without RESEND_API_KEY the receipt email is skipped and
# logged; the receipt is still viewable/printable at /book/receipt/<session_id>.
CAL_WEBHOOK_SECRET=
CAL_API_KEY=
ADMIN_EMAIL=hello@physioonclick.co.uk
# Shared secret that guards POST /api/assessment/reminder-email,
# POST /api/reviews/request-email and POST /api/exercise-plan/generate — these
# routes check the x-cron-secret header against this value. Must ALSO be set on
# the Firebase Functions runtime (alongside SITE_URL) for the
# sendAssessmentReminders scheduled function (~1h before each paid appointment),
# sendReviewRequests (~24h after) and onSummaryPublished (fires the
# exercise-plan generate route when a session summary is published).
CRON_SECRET=

# ── Reviews (Trustpilot) ──────────────────────────────────────────────────
# Trustpilot BCC method: the unique address from Trustpilot → Get reviews →
# Automatic Feedback → "Use BCC", looks like
#   physioonclick.co.uk+xxxxxxxxxx@invite.trustpilot.com
# The ~24h-after-session review email (POST /api/reviews/request-email, driven
# by the sendReviewRequests scheduled function) is BCC'd here so Trustpilot
# sends its own branded, verified invitation. Set the invitation delay in the
# Trustpilot dashboard.
TRUSTPILOT_BCC_EMAIL=
# Optional: also add a direct "Review us on Trustpilot" button to that email.
# Public evaluate link: https://www.trustpilot.com/evaluate/physioonclick.co.uk
TRUSTPILOT_REVIEW_URL=
# Trustpilot Business API (server-side, for rendering reviews on the site).
# TRUSTPILOT_API_KEY: dashboard → Integrations → API Keys (the public "apikey").
# TRUSTPILOT_BUSINESS_UNIT_ID: GET https://api.trustpilot.com/v1/business-units/find?name=physioonclick.co.uk&apikey=...
# Without both, the site falls back to the static testimonials in lib/site-data.ts.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
# Legacy Google Business Profile review link — still used as a fallback for the
# direct button only if no Trustpilot link is set. Safe to leave blank.
GOOGLE_REVIEW_URL=

# The whole service-account JSON on ONE line. FIREBASE_SERVICE_ACCOUNT_PATH is
# no longer supported: Cloudflare Workers has no filesystem, so the key cannot
# be read from disk. Generate with:
#   jq -c . path/to/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=physioonclick
FIREBASE_ADMIN_STORAGE_BUCKET=physioonclick.firebasestorage.app

# Local emulator wiring. Set per service — they are independent, and setting
# only the auth one still points Firestore at the real production project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=hello@physioonclick.co.uk
ENQUIRY_EMAIL_FROM="PhysioOnClick <onboarding@resend.dev>"
GEMINI_API_KEY=your-gemini-api-key-here
# Exercise illustration generation (scripts/generate-exercise-images.ts).
# Provider is auto-detected: OPENAI_API_KEY present -> openai, else gemini.
# - openai: a platform.openai.com key with billing (NOT ChatGPT Plus).
#   OPENAI_API_KEY=sk-...
#   EXERCISE_IMAGE_QUALITY=low|medium|high   (default medium, ~$0.04/image)
# - gemini: GEMINI_API_KEY above must have billing enabled on its AI project.
#   EXERCISE_IMAGE_MODEL=gemini-2.5-flash-image
# EXERCISE_IMAGE_PROVIDER=openai   # force one provider

# Buffer Publish API. Use a Personal API Key from:
# https://publish.buffer.com/settings/api
# Required scopes for the social automation helper:
# accountRead, postsRead, postsWrite
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_INSTAGRAM_ID=
BUFFER_CHANNEL_YOUTUBE_ID=
BUFFER_CHANNEL_TIKTOK_ID=

# Google Drive folder used as the social media asset library.
GOOGLE_DRIVE_SOCIAL_FOLDER_ID=

# Cloudinary media hosting. Used to create direct public media URLs for Buffer.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
