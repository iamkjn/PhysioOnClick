rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "hello@physioonclick.co.uk"
      );
    }

    function ownsEmailResource() {
      return isSignedIn() &&
        resource.data.email is string &&
        request.auth.token.email == resource.data.email;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pricing/{pricingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /exerciseVideos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // "Check your motion" feature: admin-authored joint-angle targets per exercise,
    // scored against client-captured motionSessions below. Mirrors exerciseVideos,
    // but read is gated to signed-in users rather than public.
    match /exerciseMotionTargets/{exerciseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Facial "Check your motion" targets (symmetry + rep thresholds for
    // palsy/stroke/older-patient facial rehab). Same access model as
    // exerciseMotionTargets: any signed-in user reads, only admin writes.
    match /faceMotionTargets/{exerciseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rehabPrograms/{programId} {
      allow read: if isAdmin() ||
        (isSignedIn() &&
          resource.data.patientEmail is string &&
          request.auth.token.email == resource.data.patientEmail);
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Bookings are only ever created server-side (Cal.com webhook, appointments/sync,
      // link-bookings), all via the Admin SDK which bypasses these rules. No legitimate
      // client path creates a booking directly, so client-side create is fully denied.
      allow create: if false;
      allow read: if isAdmin() || ownsEmailResource() ||
        (isSignedIn() && resource.data.bookedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /dependents/{dependentId} {
      // Mirrors client-side caps in lib/validation.ts / mobile validators.dart.
      // dob is a 10-char ISO date and relationship a short picklist value; the
      // caps just stop a hand-crafted client SDK write storing megabyte strings.
      function validDependent(d) {
        return d.keys().hasOnly(['ownerId', 'name', 'dob', 'relationship', 'notes',
            'avatarUrl', 'createdAt']) &&
          d.name is string && d.name.size() >= 2 && d.name.size() <= 80 &&
          d.dob is string && d.dob.size() <= 30 &&
          d.relationship is string && d.relationship.size() <= 50 &&
          d.notes is string && d.notes.size() <= 500;
      }
      function ownsDependent() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }
      // Split so create/update always run validDependent — an unconstrained
      // `allow write: if isAdmin()` would OR past it (rules grant if ANY matches).
      allow read, delete: if isAdmin() || ownsDependent();
      // ownerId is pinned immutable on update — ownsDependent() only checks the
      // pre-update ownerId, so without this an owner could re-point their own
      // dependent doc at a victim uid and plant data inside a stranger's account.
      allow update: if (isAdmin() || ownsDependent()) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        validDependent(request.resource.data);
      allow create: if (isAdmin() ||
        (isSignedIn() && request.resource.data.ownerId == request.auth.uid)) &&
        validDependent(request.resource.data);
    }

    match /sessionSummaries/{summaryId} {
      // Normally created server-side (publishSummary, Admin SDK bypasses rules);
      // these constraints cover any direct admin-client write path.
      function validSummary(d) {
        return d.workedOn is string && d.workedOn.size() >= 1 && d.workedOn.size() <= 2000 &&
          d.exercises is string && d.exercises.size() >= 1 && d.exercises.size() <= 2000 &&
          d.nextSteps is string && d.nextSteps.size() >= 1 && d.nextSteps.size() <= 2000 &&
          d.sessionOutcome in ['improving', 'stable', 'setback'] &&
          d.recoveryPercent is int && d.recoveryPercent >= 0 && d.recoveryPercent <= 100 &&
          d.painScore is number && d.painScore >= 0 && d.painScore <= 10 &&
          d.followUpWeeks is number && d.followUpWeeks >= 0;
      }
      allow read: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.bookedBy == request.auth.uid
      );
      allow create, update: if isAdmin() && validSummary(request.resource.data);
      allow delete: if isAdmin();
    }

    match /pendingSelections/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // Not currently written or read anywhere in the app (Stripe Checkout doesn't
      // mirror payment records to Firestore). Admin-only until a real writer exists,
      // rather than leaving client-writable "payment succeeded" records unused.
      allow read, write: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      // Create is public (anonymous contact form + the client-SDK fallback in
      // lib/firestore-helpers.ts), so it enforces the same caps/format/enum as
      // app/api/enquiry, plus a key allow-list to stop arbitrary-field injection.
      // Email regex mirrors EMAIL_RE in lib/validation.ts.
      function validNewEnquiry(d) {
        return d.status == 'new' &&
          d.keys().hasOnly(['name', 'email', 'emailLower', 'phone', 'service',
            'message', 'status', 'source', 'userId', 'patientRef', 'createdAt']) &&
          d.name is string && d.name.size() >= 2 && d.name.size() <= 80 &&
          d.email is string && d.email.size() <= 254 &&
          d.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
          d.phone is string && d.phone.size() <= 20 &&
          // `service` is a reserved word in the rules language — bracket-access it.
          d['service'] is string && d['service'].size() >= 1 && d['service'].size() <= 200 &&
          d.message is string && d.message.size() >= 20 && d.message.size() <= 2000;
      }
      allow create: if validNewEnquiry(request.resource.data);
      allow read: if isAdmin() || ownsEmailResource();
      allow update: if isAdmin() &&
        request.resource.data.status in ['new', 'in-progress', 'resolved'];
      allow delete: if isAdmin();
    }

    match /patients/{userId} {
      allow read, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /patients/{userId}/people/{personId}/clinicalAssessments/{date} {
      // Shape written by lib/recovery.ts addClinicalAssessment + mobile RecoveryService.
      function validAssessment(d) {
        return d.painScore is int && d.painScore >= 0 && d.painScore <= 10 &&
          d.mobilityScore is int && d.mobilityScore >= 0 && d.mobilityScore <= 10 &&
          d.physioNotes is string && d.physioNotes.size() <= 2000 &&
          d.sessionId is string && d.sessionId.size() <= 200;
      }
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() && validAssessment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /patients/{userId}/people/{personId}/assessmentForms/{formId} {
      function validRedFlags(flags) {
        return flags.keys().hasOnly([
            'majorTrauma', 'chestPainBreathlessness', 'bladderBowelSaddle',
            'progressiveWeakness', 'unexplainedFeverWeightLoss', 'nightPain', 'none']) &&
          flags.majorTrauma is bool &&
          flags.chestPainBreathlessness is bool &&
          flags.bladderBowelSaddle is bool &&
          flags.progressiveWeakness is bool &&
          flags.unexplainedFeverWeightLoss is bool &&
          flags.nightPain is bool &&
          flags.none is bool;
      }

      function validOnlineReadiness(readiness) {
        return readiness.keys().hasOnly([
            'privateSpace', 'safeSpace', 'cameraAvailable', 'emergencyContactAvailable']) &&
          readiness.privateSpace is bool &&
          readiness.safeSpace is bool &&
          readiness.cameraAvailable is bool &&
          readiness.emergencyContactAvailable is bool;
      }

      function validAssessmentConsent(consent) {
        return consent.keys().hasOnly([
            'careConsent', 'dataConsent', 'privacyConsent', 'safetySharing', 'videoConsent']) &&
          consent.careConsent == true &&
          consent.dataConsent == true &&
          consent.privacyConsent == true &&
          consent.safetySharing == true &&
          consent.videoConsent is bool;
      }

      function validClinicalArea(area) {
        return area in [
          'spine', 'upper_limb', 'lower_limb', 'balance_walking', 'neuro',
          'post_op', 'pelvic_health', 'paediatric', 'general'
        ];
      }

      function validSubjectiveAssessment(subjective) {
        return subjective is map &&
          subjective.keys().hasOnly([
            'clinicalArea', 'symptomBehaviour', 'irritability', 'severity', 'yellowFlags']) &&
          validClinicalArea(subjective.clinicalArea) &&
          subjective.symptomBehaviour is string &&
          subjective.symptomBehaviour.size() >= 10 &&
          subjective.symptomBehaviour.size() <= 1000 &&
          subjective.yellowFlags is string &&
          subjective.yellowFlags.size() <= 1000;
      }

      function validOutcomeMeasures(outcomes) {
        return outcomes is map &&
          outcomes.keys().hasOnly([
            'psfsActivity1', 'psfsScore1', 'psfsActivity2', 'psfsScore2',
            'psfsActivity3', 'psfsScore3', 'painBest', 'painWorst',
            'confidenceScore', 'conditionMeasureName', 'conditionMeasureScore',
            'conditionMeasureMax']) &&
          outcomes.psfsActivity1 is string &&
          outcomes.psfsActivity1.size() >= 2 &&
          outcomes.psfsActivity1.size() <= 160 &&
          outcomes.psfsActivity2 is string &&
          outcomes.psfsActivity2.size() <= 160 &&
          outcomes.psfsActivity3 is string &&
          outcomes.psfsActivity3.size() <= 160 &&
          outcomes.conditionMeasureName is string &&
          outcomes.conditionMeasureName.size() <= 120 &&
          outcomes.conditionMeasureScore is number &&
          outcomes.conditionMeasureScore >= 0 &&
          outcomes.conditionMeasureMax is number &&
          outcomes.conditionMeasureMax > 0 &&
          outcomes.conditionMeasureMax <= 1000 &&
          outcomes.conditionMeasureScore <= outcomes.conditionMeasureMax;
      }

      function validObjectiveVideo(video) {
        return video is map &&
          video.keys().hasOnly([
            'consent', 'taskId', 'taskLabel', 'metricName', 'metricValue',
            'metricUnit', 'reps', 'durationSeconds', 'qualityNotes', 'videoUrl',
            'storagePath', 'recordedAt']) &&
          video.consent is bool &&
          video.taskLabel is string &&
          video.taskLabel.size() >= 3 &&
          video.taskLabel.size() <= 160 &&
          video.metricName is string &&
          video.metricName.size() >= 2 &&
          video.metricName.size() <= 80 &&
          video.metricValue is number &&
          video.metricValue >= 0 &&
          video.metricUnit is string &&
          video.metricUnit.size() <= 40 &&
          video.qualityNotes is string &&
          video.qualityNotes.size() <= 1000 &&
          video.videoUrl is string &&
          video.videoUrl.size() <= 2000 &&
          (
            video.videoUrl == '' ||
            video.videoUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*') ||
            video.videoUrl.matches('^http://127[.]0[.]0[.]1:9199/.*')
          ) &&
          video.storagePath is string &&
          video.storagePath.size() <= 500 &&
          (
            video.storagePath == '' ||
            video.storagePath.matches('^patient-assessment-videos/[^/]+/.+')
          ) &&
          video.recordedAt is string &&
          video.recordedAt.size() <= 40;
      }

      function validGoalSetting(goalsPlan) {
        return goalsPlan is map &&
          goalsPlan.keys().hasOnly([
            'meaningfulGoal', 'baseline', 'target', 'timeframeWeeks',
            'confidenceScore', 'barriers', 'supportPlan', 'reviewDate']) &&
          goalsPlan.meaningfulGoal is string &&
          goalsPlan.meaningfulGoal.size() >= 3 &&
          goalsPlan.meaningfulGoal.size() <= 500 &&
          goalsPlan.baseline is string &&
          goalsPlan.baseline.size() >= 2 &&
          goalsPlan.baseline.size() <= 500 &&
          goalsPlan.target is string &&
          goalsPlan.target.size() >= 2 &&
          goalsPlan.target.size() <= 500 &&
          goalsPlan.barriers is string &&
          goalsPlan.barriers.size() <= 500 &&
          goalsPlan.supportPlan is string &&
          goalsPlan.supportPlan.size() <= 500 &&
          goalsPlan.reviewDate is string &&
          goalsPlan.reviewDate.size() <= 10;
      }

      function validAssessmentReviewFields(d) {
        return d.reviewStatus in ['awaiting_review', 'reviewed', 'needs_more_info', 'urgent_advice'] &&
          d.reviewedBy is string && d.reviewedBy.size() <= 80 &&
          d.reviewedAt is string && d.reviewedAt.size() <= 40 &&
          d.clinicianNotes is string && d.clinicianNotes.size() <= 2000 &&
          d.riskPlan is string && d.riskPlan.size() <= 2000 &&
          d.nextCheckupDate is string && d.nextCheckupDate.size() <= 10 &&
          d.updatedAt is timestamp;
      }

      // Full patient self-assessment / check-up shape written by
      // components/patient-assessment-form.tsx. Review fields are present
      // from creation so admin updates can be validated without optional-key
      // bypasses. Patients may create, but not amend submitted records.
      function validAssessmentForm(d) {
        return d.keys().hasOnly([
            'version', 'formType', 'consultationMode', 'completedVia',
            'patientName', 'completedBy', 'relationshipToPatient',
            'presentingComplaint', 'bodyArea', 'symptomStartDate', 'onsetPattern',
            'painScore', 'subjective', 'outcomes', 'objectiveVideo', 'goalsPlan',
            'symptoms', 'aggravatingFactors', 'easingFactors',
            'functionalImpact', 'goals', 'medicalHistory', 'medications',
            'allergies', 'previousTreatment', 'communicationNeeds',
            'emergencyContactName', 'emergencyContactPhone', 'redFlags',
            'onlineReadiness', 'consent', 'signature', 'submittedByUid',
            'completedAt', 'reviewStatus', 'reviewedBy', 'reviewedAt', 'clinicianNotes',
            'riskPlan', 'nextCheckupDate', 'createdAt', 'updatedAt']) &&
          d.version is string && d.version.size() >= 1 && d.version.size() <= 40 &&
          d.formType in ['initial', 'checkup'] &&
          d.consultationMode in ['online', 'in_person'] &&
          d.completedVia in ['online_form', 'offline_draft', 'offline_paper'] &&
          d.patientName is string && d.patientName.size() >= 2 && d.patientName.size() <= 80 &&
          d.completedBy is string && d.completedBy.size() >= 2 && d.completedBy.size() <= 80 &&
          d.relationshipToPatient is string && d.relationshipToPatient.size() <= 50 &&
          d.presentingComplaint is string && d.presentingComplaint.size() >= 10 && d.presentingComplaint.size() <= 2000 &&
          d.bodyArea is string && d.bodyArea.size() >= 2 && d.bodyArea.size() <= 120 &&
          d.symptomStartDate is string && d.symptomStartDate.size() <= 10 &&
          d.onsetPattern in ['sudden', 'gradual', 'recurring', 'post_surgery', 'not_sure'] &&
          d.painScore is int && d.painScore >= 0 && d.painScore <= 10 &&
          validSubjectiveAssessment(d.subjective) &&
          validOutcomeMeasures(d.outcomes) &&
          validObjectiveVideo(d.objectiveVideo) &&
          validGoalSetting(d.goalsPlan) &&
          (
            d.objectiveVideo.videoUrl == '' ||
            (d.objectiveVideo.consent == true && d.consent.videoConsent == true)
          ) &&
          (
            d.objectiveVideo.storagePath == '' ||
            d.objectiveVideo.storagePath.matches('^patient-assessment-videos/' + userId + '/.*')
          ) &&
          d.symptoms is string && d.symptoms.size() >= 10 && d.symptoms.size() <= 2000 &&
          d.aggravatingFactors is string && d.aggravatingFactors.size() <= 1000 &&
          d.easingFactors is string && d.easingFactors.size() <= 1000 &&
          d.functionalImpact is string && d.functionalImpact.size() <= 1500 &&
          d.goals is string && d.goals.size() <= 1000 &&
          d.medicalHistory is string && d.medicalHistory.size() <= 2000 &&
          d.medications is string && d.medications.size() <= 1000 &&
          d.allergies is string && d.allergies.size() <= 1000 &&
          d.previousTreatment is string && d.previousTreatment.size() <= 1000 &&
          d.communicationNeeds is string && d.communicationNeeds.size() <= 1000 &&
          d.emergencyContactName is string && d.emergencyContactName.size() <= 80 &&
          d.emergencyContactPhone is string && d.emergencyContactPhone.size() <= 20 &&
          validRedFlags(d.redFlags) &&
          validOnlineReadiness(d.onlineReadiness) &&
          validAssessmentConsent(d.consent) &&
          d.signature is string && d.signature.size() >= 2 && d.signature.size() <= 80 &&
          d.completedAt is string && d.completedAt.size() <= 40 &&
          d.submittedByUid is string && d.submittedByUid.size() <= 128 &&
          d.reviewStatus in ['awaiting_review', 'reviewed', 'needs_more_info', 'urgent_advice'] &&
          d.reviewedBy is string && d.reviewedBy.size() <= 80 &&
          d.reviewedAt is string && d.reviewedAt.size() <= 40 &&
          d.clinicianNotes is string && d.clinicianNotes.size() <= 2000 &&
          d.riskPlan is string && d.riskPlan.size() <= 2000 &&
          d.nextCheckupDate is string && d.nextCheckupDate.size() <= 10 &&
          d.createdAt is timestamp &&
          d.updatedAt is timestamp;
      }

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if validAssessmentForm(request.resource.data) &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            request.auth.uid == userId &&
            request.resource.data.submittedByUid == request.auth.uid &&
            request.resource.data.reviewStatus == 'awaiting_review' &&
            request.resource.data.reviewedBy == '' &&
            request.resource.data.reviewedAt == '' &&
            request.resource.data.clinicianNotes == '' &&
            request.resource.data.riskPlan == '' &&
            request.resource.data.nextCheckupDate == ''
          )
        );
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reviewStatus', 'reviewedBy', 'reviewedAt', 'clinicianNotes',
          'riskPlan', 'nextCheckupDate', 'updatedAt'
        ]) &&
        validAssessmentReviewFields(request.resource.data);
      allow delete: if isAdmin();
    }

    match /patients/{userId}/people/{personId}/painLogs/{date} {
      allow read, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Shape written by lib/recovery.ts logPainScore: { score, note, loggedAt }.
      // score is an integer slider value; loggedAt is a serverTimestamp readers
      // call .toDate() on, so both are typed to keep the recovery views from throwing.
      allow create, update: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) &&
        request.resource.data.keys().hasOnly(["score", "note", "loggedAt"]) &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 10 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 500 &&
        request.resource.data.loggedAt is timestamp;
    }

    match /patients/{userId}/people/{personId}/assignedExercises/{exerciseId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Patient-added YouTube reference link per assigned exercise (lib/exercise-videos.ts).
    // Separate subcollection from assignedExercises above so the owner can add their
    // own link but never touch what the physio actually assigned. Named
    // patientExerciseVideos (not exerciseVideos) so it can't collide with the
    // unrelated top-level, public-read /exerciseVideos collection matched above.
    match /patients/{userId}/people/{personId}/patientExerciseVideos/{exerciseId} {
      // Defense in depth on top of the client-side isYouTubeUrl() check in
      // lib/exercise-videos.ts: the url must actually be a YouTube link, so a
      // javascript: URI or an arbitrary https url can never be stored, even
      // from a hand-crafted client SDK write.
      function validVideoUrl(d) {
        return d.url is string && d.url.size() <= 500 &&
          d.url.matches('^https://(www\\.)?(youtube\\.com/|youtu\\.be/|m\\.youtube\\.com/).*');
      }
      allow read, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) &&
        validVideoUrl(request.resource.data);
    }

    // In-app notifications for the patient portal. Created server-side (Cloud
    // Functions / seed) or by an admin; the owner reads them and may only flip
    // `read` to true (marking as read) — they can't forge title/body/kind.
    match /patients/{userId}/notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]) &&
        request.resource.data.read is bool
      );
    }

    match /patients/{userId}/people/{personId}/exerciseLogs/{date} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // "Check your motion" feature: captured motion-check sessions, scored against
    // exerciseMotionTargets above. Explicit block (the read-only patients/** catch-all
    // below would already cover reads, but not writes) mirroring exerciseLogs' owner
    // condition exactly.
    match /patients/{userId}/people/{personId}/motionSessions/{sessionId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Admin-scheduled follow-up (scheduleFollowUp in app/admin/actions.ts, via
    // the Admin SDK shim, which bypasses this rule). The owner may only read —
    // same shape as the notifications rule above, and needed explicitly because
    // the read-only patients/{userId}/{document=**} catch-all below covers read
    // but this collection also needs an admin write path.
    match /patients/{userId}/followUps/{followUpId} {
      // Mirrors the caps in assertValidFollowUpInput (app/admin/actions.ts):
      // dueDate is a "YYYY-MM-DD" string and note is capped at LIMITS.clinicalNote.
      function validFollowUp(d) {
        return d.dueDate is string && d.dueDate.size() <= 10 &&
          d.note is string && d.note.size() <= 2000;
      }
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() && validFollowUp(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin-set daily streak goal (lib/goals.ts). The physio sets the target;
    // the owner may only read their own goal, never write it directly.
    match /patients/{userId}/people/{personId}/goals/{goalId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Defense in depth on top of the client-side check in lib/goals.ts
      // setStreakGoal — the target must be a whole number of at least 1 day.
      allow create, update: if isAdmin() &&
        request.resource.data.streakTarget is int &&
        request.resource.data.streakTarget >= 1;
      allow delete: if isAdmin();
    }

    // Shape written by the mobile blog favourite toggle (blog_screen.dart /
    // blog_detail_screen.dart), via PatientAccountService.favouriteBlogDoc. Every
    // BlogArticle field is a Dart String, so publishedAt is an ISO string, not a
    // timestamp. Writes are a full set() (no merge), so the caps apply to the whole doc.
    // Delete is separate: request.resource is null on delete, so validFavourite
    // would reject every un-favourite if folded into one write rule.
    match /patients/{userId}/favoriteBlogs/{slug} {
      function validFavourite(d) {
        return d.keys().hasOnly(['slug', 'title', 'category', 'excerpt', 'image',
          'publishedAt', 'savedAt', 'userId', 'userEmail']) &&
          d.slug is string && d.slug.size() >= 1 && d.slug.size() <= 200 &&
          d.title is string && d.title.size() <= 300 &&
          d.category is string && d.category.size() <= 100 &&
          d.excerpt is string && d.excerpt.size() <= 2000 &&
          d.image is string && d.image.size() <= 1000 &&
          d.publishedAt is string && d.publishedAt.size() <= 40 &&
          d.savedAt is timestamp &&
          d.userId is string && d.userId == userId &&
          d.userEmail is string && d.userEmail.size() <= 254;
      }
      allow read, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) &&
        validFavourite(request.resource.data);
    }

    // Shape written by the mobile document upload (profile_screen.dart) after the
    // Storage putData succeeds. storage.rules is what actually caps the bytes at 10MB;
    // mirroring the cap here just stops the Firestore record claiming a size the
    // upload never had. `size` is picked.size, a Dart int.
    match /patients/{userId}/uploads/{uploadId} {
      function validUpload(d) {
        return d.keys().hasOnly(['fileName', 'downloadUrl', 'storagePath', 'size',
          'uploadedAt', 'uploadedBy', 'extension']) &&
          d.fileName is string && d.fileName.size() >= 1 && d.fileName.size() <= 255 &&
          d.downloadUrl is string && d.downloadUrl.size() <= 2000 &&
          d.storagePath is string && d.storagePath.size() <= 500 &&
          d.size is int && d.size >= 0 && d.size <= 10 * 1024 * 1024 &&
          d.uploadedAt is timestamp &&
          d.uploadedBy is string && d.uploadedBy.size() <= 254 &&
          d.extension is string && d.extension.size() <= 10;
      }
      allow read, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (isSignedIn() && request.auth.uid == userId)) &&
        validUpload(request.resource.data);
    }

    // Read-only catch-all. No blanket admin write: overlapping matches grant if ANY
    // allows, so a write rule here would let admin clients skip the validation in the
    // explicit subcollection matches above (e.g. clinicalAssessments caps). Every
    // server-side write (chat transcripts, cal-webhook) uses the Admin SDK shim,
    // which bypasses rules entirely.
    match /patients/{userId}/{document=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Collection-group rule for the admin chat logs viewer (components/admin-chat-logs.tsx),
    // which runs a collectionGroup("chatSessions") query across all patients/{uid}/chatSessions/{id}.
    // The recursive wildcard under /patients/{userId} above only authorizes per-patient reads,
    // not cross-patient collection-group queries — this is required in addition to it.
    // Read-only: chatSessions are written server-side (app/api/chat via the Admin SDK shim).
    match /{path=**}/chatSessions/{sessionId} {
      allow read: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
