{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physioonclick",
  "main": ".open-next/worker.js",

  // 2025-04-01+ is required for vars defined here to appear in `process.env`.
  // Lowering this date silently breaks every process.env read in the app.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "physioonclick"
    }
  ],

  // Custom domains. `custom_domain: true` makes wrangler create the DNS record
  // and TLS cert on deploy — do NOT also hand-create A/CNAME records for these
  // in the dashboard, the two will fight. The zone's MX/SPF/DKIM records
  // (IONOS email, Resend sending) are untouched by this and must stay.
  "routes": [
    { "pattern": "physioonclick.co.uk", "custom_domain": true },
    { "pattern": "www.physioonclick.co.uk", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  },

  // Non-secret runtime config only. Secrets (CAL_API_KEY, CAL_WEBHOOK_SECRET,
  // GEMINI_API_KEY, RESEND_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON) are set with
  // `wrangler secret put` / the dashboard and must NEVER be listed here — this
  // file is committed.
  //
  // NEXT_PUBLIC_* is deliberately absent: Next inlines those at BUILD time, so
  // they must exist in the build environment, not here. Setting them at runtime
  // does nothing. See .env.example.
  "vars": {
    "FIREBASE_ADMIN_PROJECT_ID": "physioonclick-prod",
    "FIREBASE_ADMIN_STORAGE_BUCKET": "physioonclick-prod.firebasestorage.app"
  },

  // --- DEV environment -------------------------------------------------
  // A SEPARATE worker (`physioonclick-dev`) on dev.physioonclick.co.uk, wired
  // to the physioonclick-dev Firebase project and Stripe TEST keys. Deploy with:
  //   npm run deploy:dev      (build injects dev NEXT_PUBLIC_* then deploys -e dev)
  // `vars`, `services` and `routes` are NOT inherited by environments in
  // wrangler, so they are repeated here on purpose — changing the top-level
  // block alone would leave dev pointing at prod.
  //
  // BUILD HAZARD: NEXT_PUBLIC_* are inlined at build time, so the .open-next
  // artifact is environment-specific. After deploying dev, ALWAYS rebuild before
  // deploying prod (`npm run deploy` does a fresh build, so just never run a bare
  // `opennextjs-cloudflare deploy` after a dev build).
  "env": {
    "dev": {
      "name": "physioonclick-dev",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "physioonclick-dev"
        }
      ],
      "routes": [
        { "pattern": "dev.physioonclick.co.uk", "custom_domain": true }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "FIREBASE_ADMIN_PROJECT_ID": "physioonclick-dev",
        "FIREBASE_ADMIN_STORAGE_BUCKET": "physioonclick-dev.firebasestorage.app"
      }
    }
  }
}
